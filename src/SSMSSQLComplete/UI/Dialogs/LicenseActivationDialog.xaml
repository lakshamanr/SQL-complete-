<Window x:Class="SSMSSQLComplete.UI.Dialogs.LicenseActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate SSMS SQL Complete"
        Height="400" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SSMS SQL Complete" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Enter your license key to activate the full version" FontSize="14" Foreground="#666"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- License Key -->
            <TextBlock Grid.Row="0" Text="License Key:" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1"
                     Name="LicenseKeyTextBox"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextChanged="LicenseKeyTextBox_TextChanged"
                     ToolTip="Format: SSMS-XXXXX-XXXXX-XXXXX-XXXXX-SIGNATURE"/>

            <!-- Licensed To -->
            <TextBlock Grid.Row="2" Text="Licensed To (Optional):"/>
            <TextBox Grid.Row="3" Name="LicensedToTextBox"/>

            <!-- Machine ID -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,8">
                <TextBlock Text="Machine ID: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Name="MachineIdTextBox"
                         IsReadOnly="True"
                         Background="#F5F5F5"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Width="200"
                         Padding="4,2"
                         Margin="4,0,8,0"/>
                <Button Content="Copy"
                        Click="CopyMachineId_Click"
                        Padding="8,2"
                        MinWidth="60"
                        ToolTip="Copy Machine ID to clipboard"/>
            </StackPanel>

            <!-- Status Message -->
            <Border Grid.Row="5"
                    Background="#FFF9E6"
                    BorderBrush="#FFD700"
                    BorderThickness="1"
                    Padding="12"
                    CornerRadius="4"
                    Visibility="{Binding StatusVisibility}">
                <StackPanel>
                    <TextBlock Name="StatusMessageTextBlock"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#333"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Start Trial"
                    Click="StartTrial_Click"
                    Name="StartTrialButton"
                    ToolTip="Start 30-day trial period"/>
            <Button Content="Activate"
                    Click="Activate_Click"
                    Name="ActivateButton"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
